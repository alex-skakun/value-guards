{
  "name": "value-guards",
  "version": "2.0.1",
  "sideEffects": false,
  "author": {
    "email": "alex.skakun@me.com",
    "name": "Aleksey Skakun",
    "url": "https://github.com/alex-skakun"
  },
  "repository": {
    "url": "git+https://github.com/alex-skakun/value-guards.git"
  },
  "license": "MIT",
  "keywords": [
    "isPresent",
    "isNonPresent",
    "isDefined",
    "isFunction",
    "isClass",
    "isEmptyArray",
    "isNonEmptyArray",
    "isEmptyRecord",
    "isNonEmptyRecord",
    "isFiniteNumber",
    "isSafeInteger",
    "isPositiveSafeInteger",
    "isNonNegativeSafeInteger",
    "isSafeNumber",
    "mapHas",
    "setHas",
    "isEmptyInputValue"
