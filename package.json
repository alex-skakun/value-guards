  "scripts": {
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "build": "bun run ./tools/index.ts build ./dist",
    "prerelease": "npm run build",
    "release": "bun run ./tools/index.ts publish ./dist"
  },
  "dependencies": {
    "tslib": "^2.8.1",
    "type-fest": "^5.5.0"
  },
  "devDependencies": {
    "@inquirer/prompts": "8.3.2",
    "@types/bun": "1.3.11",
    "@types/node": "24.12.0",
    "chalk": "5.6.2",
    "commander": "14.0.3",
    "rxjs": "7.8.2",
    "typescript": "5.9.3"
  }
}
